# ── 광고주 측 호스트 (루트 · lp. · m. · app.) ────────────────
#
# 이 파일은 ${SHOP_DOMAIN} 의 인증서가 실재할 때만 생성된다.
# 없는데 만들면 nginx 가 기동 자체를 거부하고, 그러면 ACME 챌린지를 받을
# 80번 블록까지 같이 죽어서 인증서를 영원히 못 받는다.
# → docker/openresty/entrypoint.sh
    # ── 443 기본 블록 — 모르는 Host 를 여기서 끊는다 ──────────
    #
    # **이 블록은 콘텐츠를 서빙하지 않는다.** 존재 이유가 하나다:
    # 브리지가 Location 을 $http_host 로 만들기 때문에, 모르는 Host 가
    # PHP 까지 닿으면 그게 곧 오픈 리다이렉트다 → docs/failure-scenarios.md C-3
    #
    # 아래 return 은 목적지를 하드코딩하므로 Host 가 무엇이든 결과가 같다.
    # server_name 을 `_` 로 둔 것은 **어떤 이름과도 일치하지 않게** 하려는
    # 것이다 — 이름으로 매칭되는 일 없이 오직 default_server 로만 걸린다.
    #
    # 루트 도메인은 아래 별도 블록에서 홈을 서빙한다. 두 역할을 한 블록에
    # 두면 홈을 붙이는 순간 C-3 방어선이 사라진다.
    server {
        listen 443 ssl default_server;
        http2 on;
        server_name _;

        # 이름이 안 맞는 인증서다. 거절 응답이므로 그래도 된다 —
        # 클라이언트가 경고를 보는 것이 정상이고, 여기까지 온 것 자체가
        # 우리가 모르는 이름으로 왔다는 뜻이다.
        ssl_certificate     /etc/letsencrypt/live/${SHOP_DOMAIN}/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/${SHOP_DOMAIN}/privkey.pem;
        include /etc/nginx/conf.d/tls-common.conf;

        return 302 https://lp.${SHOP_DOMAIN}$request_uri;
    }

    # ── 루트 도메인 — 웹툰 홈 ────────────────────────────────
    #
    # 전에는 이 자리가 lp. 로 302 하는 블록이었다. 홈을 붙이면서 갈랐다.
    # 여기는 **이름으로 매칭되는** 블록이고, 위 기본 블록은 이름이 없다.
    server {
        listen 443 ssl;
        http2 on;
        server_name ${SHOP_DOMAIN};

        ssl_certificate     /etc/letsencrypt/live/${SHOP_DOMAIN}/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/${SHOP_DOMAIN}/privkey.pem;
        include /etc/nginx/conf.d/tls-common.conf;

        set $read_target "";

        access_by_lua_block {
            require("replica").assign()
        }

        include /etc/nginx/conf.d/php-app.conf;
    }

    # ── lp. 랜딩 · 브리지 (광고주 측) ────────────────────────
    server {
        listen 443 ssl;
        http2 on;
        server_name lp.${SHOP_DOMAIN};

        ssl_certificate     /etc/letsencrypt/live/${SHOP_DOMAIN}/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/${SHOP_DOMAIN}/privkey.pem;
        include /etc/nginx/conf.d/tls-common.conf;

        set $read_target "";

        # 모바일이면 m. 으로 302. 쿼리스트링은 그대로 넘긴다.
        # (넘긴다고 해서 유실이 없는 것은 아니다 — 실험 대상이다)
        if ($is_mobile) {
            return 302 https://m.${SHOP_DOMAIN}$request_uri;
        }

        access_by_lua_block {
            require("replica").assign()
        }

        include /etc/nginx/conf.d/php-app.conf;

        # /go 를 별도 location 으로 두지 않는다.
        #
        # 두었을 때 이렇게 깨졌다. php-pass.conf 는 SCRIPT_FILENAME 을
        # $document_root$fastcgi_script_name 으로 만드는데, /go 는 실제 파일이
        # 아니므로 /var/www/html/public/go 를 가리키게 되고 PHP-FPM 이
        # "File not found" 로 404 를 낸다. 프론트 컨트롤러를 거치지 않은 것이다.
        #
        # 그래서 위의 try_files 에 맡긴다. no-store 는 앱이 직접 붙인다 —
        # 캐시 정책은 그 응답이 무엇인지 아는 쪽이 정하는 게 맞고,
        # 이미 CORS 를 같은 이유로 앱에 맡기고 있다.
    }

    # ── m. 모바일 (같은 앱, 다른 뷰) ─────────────────────────
    server {
        listen 443 ssl;
        http2 on;
        server_name m.${SHOP_DOMAIN};

        ssl_certificate     /etc/letsencrypt/live/${SHOP_DOMAIN}/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/${SHOP_DOMAIN}/privkey.pem;
        include /etc/nginx/conf.d/tls-common.conf;

        set $read_target "";
        access_by_lua_block { require("replica").assign() }
        include /etc/nginx/conf.d/php-app.conf;
    }

    # ── app. 서비스 · 전환 (광고주 측) ───────────────────────
    server {
        listen 443 ssl;
        http2 on;
        server_name app.${SHOP_DOMAIN};

        ssl_certificate     /etc/letsencrypt/live/${SHOP_DOMAIN}/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/${SHOP_DOMAIN}/privkey.pem;
        include /etc/nginx/conf.d/tls-common.conf;

        set $read_target "";
        access_by_lua_block { require("replica").assign() }
        include /etc/nginx/conf.d/php-app.conf;
    }

    # ── api. 수집 (같은 등록 도메인, 다른 오리진) ────────────
    #
    # 등록 도메인을 1개로 정하면서 수집 호스트가 여기로 왔다 → ADR-018
    #
    # lp.${SHOP_DOMAIN} → api.${SHOP_DOMAIN} 은
    #   same-site   등록 도메인이 같다 → 서드파티 쿠키 차단이 일어나지 않는다
    #   cross-origin 서브도메인이 다르다 → CORS 는 그대로 적용된다
    #
    # 그래서 preflight·Vary: Origin·Allow-Origin:* 와 credentials 충돌은
    # 여전히 재현된다. 잃은 것은 A-1(서드파티 쿠키)과 A-2(SameSite=None) 뿐이다.
    server {
        listen 443 ssl;
        http2 on;
        server_name api.${SHOP_DOMAIN};

        ssl_certificate     /etc/letsencrypt/live/${SHOP_DOMAIN}/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/${SHOP_DOMAIN}/privkey.pem;
        include /etc/nginx/conf.d/tls-common.conf;

        set $read_target "";
        access_by_lua_block { require("replica").assign() }

        # CORS 도 no-store 도 앱이 붙인다. 오리진을 정확히 반향하고 Vary 를
        # 붙이는 판단은 요청을 이해하는 쪽이 해야 한다 → docs/api-spec.md 3장
        include /etc/nginx/conf.d/php-app.conf;
    }
