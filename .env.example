# attribution-bridge · 환경 설정 예시
# cp .env.example .env 후 값을 채운다. .env는 절대 커밋하지 않는다.

# ─────────────────────────────────────────────────────────
# 도메인 — 반드시 등록 도메인 2개. 서브도메인만 나누면 실험이 성립하지 않는다.
# 근거: docs/decisions/ADR-002-two-registered-domains.md
# ─────────────────────────────────────────────────────────
SHOP_DOMAIN=toonlab.example          # 광고주 측 → lp. / app.
TRACK_DOMAIN=abridge.example         # 추적 측   → api.
ACME_EMAIL=you@example.com           # Let's Encrypt 만료 알림 수신

# ACME 스테이징 전환은 환경변수가 아니라 Caddyfile의 acme_ca 줄을 직접 주석
# 해제/처리해서 한다. Caddyfile에는 조건 분기가 없기 때문이다.
# 처음에는 반드시 스테이징으로 검증한다 — 프로덕션은 도메인당 주 5회 제한이라
# 설정 시행착오로 소모하면 일주일을 날린다. 절차: docs/setup.md 4~5장

# ─────────────────────────────────────────────────────────
# 애플리케이션
# ─────────────────────────────────────────────────────────
CI_ENVIRONMENT=production
APP_TIMEZONE=UTC                     # 저장·연산은 UTC. 표시 직전에만 변환한다
ENCRYPTION_KEY=                      # php spark key:generate 로 채운다

# ─────────────────────────────────────────────────────────
# MySQL 8.0
# ─────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=                 # 직접 채운다. 비워두면 컨테이너가 뜨지 않는다
MYSQL_DATABASE=attribution
MYSQL_USER=ab
MYSQL_PASSWORD=

# 읽기/쓰기 커넥션 분리 — ADR-007
# 복제본을 실제로 띄우지는 않는다. 같은 호스트를 가리키되 코드에서 경로를 나눈다.
DB_WRITE_HOST=mysql
DB_READ_HOST=mysql
DB_PORT=3306

# 읽기 경로에 인위적 지연을 주입해 read-after-write 이상을 재현한다.
# 0 = 비활성. 실험 시 2000 정도로 올린다. (docs/failure-scenarios.md E-1)
REPLICA_LAG_MS=0

# ─────────────────────────────────────────────────────────
# 쿠키 — docs/domains-and-cookies.md 3장의 정책표와 일치해야 한다
# ─────────────────────────────────────────────────────────
COOKIE_VID_NAME=ab_vid               # first-party. SameSite=Lax
COOKIE_TID_NAME=ab_tid               # third-party.  SameSite=None; Secure; Partitioned
COOKIE_TID_SAMESITE=None
COOKIE_TID_PARTITIONED=true          # CHIPS. SameSite=None + Secure와 함께여야 효력이 있다
COOKIE_VID_MAX_AGE=31536000          # 1년

# 실험용 스위치 — 일부러 잘못된 값을 넣어 무엇이 깨지는지 관측한다
CORS_ALLOW_ORIGIN_WILDCARD=false     # true로 두면 credentials와 충돌해 쿠키가 끊긴다
BRIDGE_REDIRECT_STATUS=302           # 301로 바꾸면 브라우저가 영구 캐시한다
BRIDGE_PARAM_MODE=vid                # vid | passthru — 파라미터 전달 2방식 비교

# ─────────────────────────────────────────────────────────
# 매체 채널 — 신규 매체는 여기 한 줄 + 어댑터 클래스 1개 (ADR-005)
# ─────────────────────────────────────────────────────────
CHANNELS=ga4,meta

GA4_MEASUREMENT_ID=                  # G-XXXXXXXXXX
GA4_API_SECRET=                      # GA4 관리 > 데이터 스트림 > Measurement Protocol
GA4_DEBUG=true                       # true면 /debug/mp/collect 로 보내 검증 응답을 받는다

META_PIXEL_ID=
META_ACCESS_TOKEN=
META_TEST_EVENT_CODE=                # Events Manager > 테스트 이벤트 탭의 코드

# ─────────────────────────────────────────────────────────
# 워커 — 백오프 값은 실험으로 정한다 (docs/benchmarks.md 4장)
# ─────────────────────────────────────────────────────────
WORKER_POLL_INTERVAL_MS=1000
WORKER_BATCH_SIZE=100
DISPATCH_MAX_ATTEMPT=6               # 초과 시 dead
DISPATCH_TIMEOUT_MS=3000
