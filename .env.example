# touchpoint · 환경 설정 예시
# cp .env.example .env 후 값을 채운다. .env는 절대 커밋하지 않는다.

# ─────────────────────────────────────────────────────────
# 도메인 — 등록 도메인 1개로 확정 (ADR-018). 수집은 api.<SHOP_DOMAIN> 이 맡는다.
# 근거: docs/decisions/ADR-018-single-registered-domain.md
# ─────────────────────────────────────────────────────────
SHOP_DOMAIN=sshwan.com               # 루트 + lp. / m. / app. / api.
# 별도 추적 도메인. 지금은 쓰지 않는다 — 비워 두면 api.<SHOP_DOMAIN> 이 수집을 맡는다.
# 채우면 cross-site 실험(서드파티 쿠키·SameSite=None)이 열린다. 코드는 준비돼 있다.
TRACK_DOMAIN=
ACME_EMAIL=you@example.com           # Let's Encrypt 만료 알림 수신
ACME_STAGING=true                    # 처음에는 반드시 true. 비우면 프로덕션 발급

# ACME는 certbot(webroot)으로 발급한다. 처음에는 반드시 --staging 으로 검증한다.
#   docker compose --profile cert run --rm certbot
# 프로덕션은 도메인당 주 5회 제한이라 시행착오로 소모하면 일주일을 날린다.
# 절차: docs/setup.md 4~5장

# ─────────────────────────────────────────────────────────
# 애플리케이션
# ─────────────────────────────────────────────────────────
CI_ENVIRONMENT=production        # CodeIgniter 3
APP_TIMEZONE=UTC                     # 저장·연산은 UTC. 표시 직전에만 변환한다
ENCRYPTION_KEY=                      # CI3 config의 encryption_key. openssl rand -hex 16

# ─────────────────────────────────────────────────────────
# MySQL 8.0
# ─────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=                 # 직접 채운다. 비워두면 컨테이너가 뜨지 않는다
MYSQL_DATABASE=attribution
MYSQL_USER=ab
MYSQL_PASSWORD=

# 읽기/쓰기 커넥션 분리 — ADR-007
# 복제본을 실물로 띄운다. 흉내가 아니다. → ADR-014 정렬 원칙
DB_WRITE_HOST=mysql-primary

# 읽기 대상 2개. OpenResty의 Lua가 쿠키로 하나를 배정하고
# AB_READ_TARGET 파라미터로 앱에 넘긴다. → docker/openresty/lua/replica.lua
DB_READ_RDB1=mysql-primary           # 지연 0 (프라이머리를 읽기로 사용)
DB_READ_RDB2=mysql-replica           # 실제 복제 지연 발생
DB_PORT=3306

# 복제 지연을 인위적으로 키운다. mysql-replica 의 SOURCE_DELAY(초).
# 0 = 실제 지연만. 실험 시 5~10으로 올린다. docs/failure-scenarios.md E-1
REPL_DELAY_SECONDS=0
REPL_PASSWORD=                        # 직접 채운다. openssl rand -hex 16

# ─────────────────────────────────────────────────────────
# 쿠키 — docs/domains-and-cookies.md 3장의 정책표와 일치해야 한다
# ─────────────────────────────────────────────────────────
COOKIE_VID_NAME=ab_vid               # first-party. SameSite=Lax
COOKIE_TID_NAME=ab_tid               # 수집 측. same-site 라 Lax 로 충분하다
COOKIE_TID_SAMESITE=Lax
COOKIE_TID_PARTITIONED=false         # CHIPS 는 SameSite=None 과 함께여야 효력. 지금은 해당 없음
COOKIE_VID_MAX_AGE=31536000          # 1년

# 실험용 스위치 — 일부러 잘못된 값을 넣어 무엇이 깨지는지 관측한다
CORS_ALLOW_ORIGIN_WILDCARD=false     # true로 두면 credentials와 충돌해 쿠키가 끊긴다
BRIDGE_REDIRECT_STATUS=302           # 301로 바꾸면 브라우저가 캐시할 수 있다
BRIDGE_CACHE_CONTROL=no-store        # 비우면 캐시 헤더를 안 붙인다. 301 과 함께 두면 사고가 재현된다
BRIDGE_PARAM_MODE=vid                # vid | passthru — 파라미터 전달 2방식 비교

# ─────────────────────────────────────────────────────────
# 매체 채널 — 신규 매체는 여기 한 줄 + 어댑터 클래스 1개 (ADR-005)
# ─────────────────────────────────────────────────────────
CHANNELS=ga4,meta

GA4_MEASUREMENT_ID=                  # G-XXXXXXXXXX. 비우면 gtag 스니펫이 출력되지 않는다
GA4_API_SECRET=                      # GA4 관리 > 데이터 스트림 > Measurement Protocol
GA4_DEBUG=true                       # true면 /debug/mp/collect 로 보내 validationMessages 를 받는다

# 모든 이벤트에 traffic_type 파라미터를 붙인다. GA4 예약 파라미터라
# 관리 > 데이터 스트림 > 내부 트래픽 정의와 맞물려 보고서에서 걸러낼 수 있다.
# 부하·검증 트래픽을 운영 속성에 지울 방법 없이 쏟아붓지 않으려는 장치다.
# 비우면 붙이지 않는다. (필터 규칙은 GA4 쪽에 따로 만들어야 실제로 걸러진다)
GA4_TRAFFIC_TYPE=

META_PIXEL_ID=
META_ACCESS_TOKEN=
META_TEST_EVENT_CODE=                # Events Manager > 테스트 이벤트 탭의 코드

# ─────────────────────────────────────────────────────────
# 워커 — 백오프 값은 실험으로 정한다 (docs/benchmarks.md 4장)
# ─────────────────────────────────────────────────────────
WORKER_POLL_INTERVAL_MS=1000
WORKER_BATCH_SIZE=100
DISPATCH_TIMEOUT_MS=3000

# 재시도 횟수는 여기서 못 바꾼다. src/Dispatch/BackoffPolicy 의 WAIT_SECONDS
# 사다리(30s · 2m · 10m · 1h · 3h)가 끝나면 dead 다.
#   원래 DISPATCH_MAX_ATTEMPT=6 이라고 적혀 있었는데 **아무도 읽지 않는 값**이었다.
#   고쳐도 동작이 안 바뀌는 설정은 없는 것만 못해서 지웠다.

# 실패 주입. noop 채널이 무엇을 돌려줄지 고른다 (D-2 재현용, 운영에서는 sent)
#   sent 204 · retry 503(5xx, 재시도) · dead 400(4xx, 재시도 안 함)
NOOP_OUTCOME=sent

# 선점 쿼리의 SKIP LOCKED. 운영에서 끌 이유는 없고, 끄는 쪽을 돌려 봐야
# 켜는 쪽이 얼마를 버는지 말할 수 있어서 열어 뒀다 (D-1 대조군).
OUTBOX_SKIP_LOCKED=true

# ─────────────────────────────────────────────────────────
# 스택 정렬 관련 (ADR-014)
# ─────────────────────────────────────────────────────────
# 모바일 UA를 m. 호스트로 302 분기할지. 대상 조직의 동작을 재현한다.
# 끄면 다단 리다이렉트 없이 동작해 대조 실험이 된다.
MOBILE_REDIRECT_ENABLED=true

# 유료 회차 접근통제를 서빙 시점에 판정할지, 뷰 플래그만 볼지.
# false로 두면 URL만 바꿔 유료 회차가 열린다 — 일부러 재현하기 위한 스위치.
ENFORCE_EPISODE_ENTITLEMENT=true
