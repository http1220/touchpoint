# 비밀값 — 절대 커밋하지 않는다
.env
.env.*
!.env.example

# 서비스 계정 키 — 이 파일 하나로 GA4 속성을 읽을 수 있다
/secrets/
*-sa.json

# 의존성
/vendor/

# CI4 런타임
/writable/cache/*
/writable/logs/*
/writable/session/*
/writable/uploads/*
/writable/debugbar/*
!/writable/**/.gitkeep

# 계측 산출물 (원문은 docs/benchmarks.md에 정리해 넣는다)
/tmp/
*.log

# OS · 에디터
.DS_Store
Thumbs.db
.idea/
.vscode/

# PHPUnit
/.phpunit.cache/
/.phpunit.result.cache

# CI3 런타임 산출물
/application/cache/*
/application/logs/*
!/application/cache/index.html
!/application/logs/index.html
